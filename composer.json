{
    "name": "javaabu/imports",
    "description": "Streamline excel data import to your application",
    "homepage": "https://github.com/Javaabu/imports",
    "license": "MIT",
    "keywords": [
        "javaabu",
        "laravel",
        "imports"
    ],
    "authors": [
        {
            "name": "Arushad Ahmed",
            "email": "arushad@javaabu.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "maatwebsite/excel": "^3.1",
        "javaabu/forms": "^1.67"
    },
    "require-dev": {
        "laravel/pint": "^1.14",
        "orchestra/testbench": "^8.0 || ^9.16 || ^10.0 || ^11.0",
        "phpunit/phpunit": "^10.5 || ^11.5.3 || ^12.5.8 || ^13.0.3"
    },
    "autoload": {
        "psr-4": {
            "Javaabu\\Imports\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Javaabu\\Imports\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "2.0-dev"
        },
        "laravel": {
            "providers": [
                "Javaabu\\Imports\\ImportsServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
